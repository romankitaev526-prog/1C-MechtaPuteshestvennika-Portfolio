		<query>ВЫБРАТЬ
	Договор.Ссылка КАК Договор,
	Договор.Номер КАК НомерДоговора,
	Договор.Дата КАК ДатаДоговора,
	Договор.Клиент КАК Клиент,
	МИНИМУМ(Маршрут.Город.Страна.Наименование) КАК Страна,
	МИНИМУМ(Маршрут.Город.Наименование) КАК Город,
	Договор.НачалоПоездки КАК НачалоПоездки,
	Договор.ОкончаниеПоездки КАК ОкончаниеПоездки,
	Договор.КоличествоУчастников КАК КоличествоУчастников,
	Договор.Сумма КАК Сумма,
	Договор.Валюта КАК Валюта
ИЗ
	Документ.Договор КАК Договор
	ЛЕВОЕ СОЕДИНЕНИЕ Документ.Договор.МаршрутПоездки КАК Маршрут
	ПО Договор.Ссылка = Маршрут.Ссылка
ГДЕ
	Договор.НачалоПоездки МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода

СГРУППИРОВАТЬ ПО
	Договор.Ссылка,
	Договор.Номер,
	Договор.Дата,
	Договор.Клиент,
	Договор.НачалоПоездки,
	Договор.ОкончаниеПоездки,
	Договор.КоличествоУчастников,
	Договор.Сумма,
	Договор.Валюта</query>
