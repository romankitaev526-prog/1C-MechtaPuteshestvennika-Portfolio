Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	// Запрет удаления, если есть договоры
	Если ПометкаУдаления ИЛИ РежимЗаписи = "Удаление" Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Договор.Ссылка) КАК КоличествоДоговоров
		|ИЗ Документ.Договор КАК Договор
		|ГДЕ Договор.Соглашение = &Ссылка";
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		
		Результат = Запрос.Выполнить().Выбрать();
		Результат.Следующий();
		
		Если Результат.КоличествоДоговоров > 0 Тогда
			Отказ = Истина;
			Сообщить("Нельзя удалить или пометить на удаление соглашение, на основании которого создан договор!");
			Возврат;
		КонецЕсли;
		
	КонецЕсли;

	// Проверка обязательных полей
	Если Организация = Неопределено Тогда
		Сообщить("Заполните организацию!");
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Если Клиент = Неопределено Тогда
		Сообщить("Заполните клиента!");
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Если СтранаПосещения = Неопределено Тогда
		Сообщить("Заполните страну посещения!");
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Если НачалоПоездки = '00010101' Тогда
		Сообщить("Заполните начало поездки!");
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Если ОкончаниеПоездки = '00010101' Тогда
		Сообщить("Заполните окончание поездки!");
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Если КоличествоУчастников <= 0 Тогда
		Сообщить("Укажите количество участников!");
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Если ГородаПосещения.Количество() = 0 Тогда
		Сообщить("Добавьте хотя бы один город!");
		Отказ = Истина;
		Возврат;
	КонецЕсли;

КонецПроцедуры            

Функция Печать(МассивОбъектов = Неопределено) Экспорт

	Если МассивОбъектов = Неопределено Тогда
		МассивОбъектов = Новый Массив;
		МассивОбъектов.Добавить(Ссылка);
	КонецЕсли;
	
	Возврат ПечатьСоглашения(МассивОбъектов);
	
КонецФункции

Функция ПечатьСоглашения(МассивОбъектов)
	
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.ИмяПараметровПечати = "ПечатнаяФорма";
	
	Макет = ПолучитьМакет("ПечатнаяФорма");
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьДанные = Макет.ПолучитьОбласть("Данные");
	ОбластьШапкаТЧ = Макет.ПолучитьОбласть("ШапкаТЧ");
	ОбластьДанныеТЧ = Макет.ПолучитьОбласть("ДанныеТЧ");
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
	
	Для каждого ТекДокумент Из МассивОбъектов Цикл
		
		ДокОбъект = ТекДокумент.ПолучитьОбъект();
		
		// Шапка
		ОбластьШапка.Параметры.НомерСоглашения = ДокОбъект.Номер;
		ОбластьШапка.Параметры.ДатаСоглашения = Формат(ДокОбъект.Дата, "ДЛФ=Д");
		ТабДок.Вывести(ОбластьШапка);
		
		// Данные
		ОбластьДанные.Параметры.Организация = ДокОбъект.Организация;
		ОбластьДанные.Параметры.Агент = ДокОбъект.Агент;
		ОбластьДанные.Параметры.Клиент = ДокОбъект.Клиент;
		ОбластьДанные.Параметры.Страна = ДокОбъект.СтранаПосещения;
		ОбластьДанные.Параметры.ДатыПоездки = Формат(ДокОбъект.НачалоПоездки, "ДЛФ=Д") + " - " + Формат(ДокОбъект.ОкончаниеПоездки, "ДЛФ=Д");
		ОбластьДанные.Параметры.КоличествоУчастников = ДокОбъект.КоличествоУчастников;
		ТабДок.Вывести(ОбластьДанные);
		
		// Шапка таблицы городов
		ТабДок.Вывести(ОбластьШапкаТЧ);
		
		// Строки городов
		НомерСтроки = 1;
		Для каждого СтрокаГорода Из ДокОбъект.ГородаПосещения Цикл
			ОбластьДанныеТЧ.Параметры.НомерСтроки = НомерСтроки;
			ОбластьДанныеТЧ.Параметры.Город = СтрокаГорода.Город;
			ТабДок.Вывести(ОбластьДанныеТЧ);
			НомерСтроки = НомерСтроки + 1;
		КонецЦикла;
		
		// Подвал
		ОбластьПодвал.Параметры.Агент = ДокОбъект.Агент;
		ОбластьПодвал.Параметры.Клиент = ДокОбъект.Клиент;
		ТабДок.Вывести(ОбластьПодвал);
		
		// Разделитель между документами
		Если МассивОбъектов.Найти(ТекДокумент) < МассивОбъектов.Количество() - 1 Тогда
			ТабДок.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТабДок;
	
КонецФункции