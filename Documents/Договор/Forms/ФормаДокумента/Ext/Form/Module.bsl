&НаКлиенте
Процедура СоглашениеПриИзменении(Элемент)
    Если Объект.Соглашение = Неопределено Тогда
        Возврат;
    КонецЕсли;
    ЗаполнитьИзСоглашенияНаСервере();
    
    // Применяем фильтр для городов по стране
    МаршрутПоездкиГородНачалоВыбора(Элементы.МаршрутПоездкиГород, Неопределено, Неопределено);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИзСоглашенияНаСервере()
    Если Объект.Соглашение = Неопределено Тогда
        Возврат;
    КонецЕсли;
    
    СоглашениеОбъект = Объект.Соглашение.ПолучитьОбъект();
    Если СоглашениеОбъект = Неопределено Тогда
        Возврат;
    КонецЕсли;
    
    // 1. Заполняем шапку договора данными из соглашения
    Объект.Организация = СоглашениеОбъект.Организация;
    Объект.Агент = СоглашениеОбъект.Агент;
    Объект.Клиент = СоглашениеОбъект.Клиент;
    Объект.СтранаПосещения = СоглашениеОбъект.СтранаПосещения;
    Объект.НачалоПоездки = СоглашениеОбъект.НачалоПоездки;
    Объект.ОкончаниеПоездки = СоглашениеОбъект.ОкончаниеПоездки;
    Объект.КоличествоУчастников = СоглашениеОбъект.КоличествоУчастников;
    
    // 2. Очищаем и заполняем маршрут поездки городами из соглашения
    Объект.МаршрутПоездки.Очистить();
    Для каждого СтрокаСоглашения Из СоглашениеОбъект.ГородаПосещения Цикл
        НоваяСтрока = Объект.МаршрутПоездки.Добавить();
        НоваяСтрока.Город = СтрокаСоглашения.Город;
        
        // 3. Подставляем даты из шапки в каждую строку маршрута
        НоваяСтрока.ДатаНачала = Объект.НачалоПоездки;
        НоваяСтрока.ДатаОкончания = Объект.ОкончаниеПоездки;
    КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура МаршрутПоездкиГородНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
    // Если элемент не передан — выходим
    Если Элемент = Неопределено Тогда
        Возврат;
    КонецЕсли;
    
    Если ЗначениеЗаполнено(Объект.СтранаПосещения) Тогда
        НовыйОтбор = Новый ПараметрВыбора("Отбор.Страна", Объект.СтранаПосещения);
        МассивПараметров = Новый Массив;
        МассивПараметров.Добавить(НовыйОтбор);
        Элемент.ПараметрыВыбора = Новый ФиксированныйМассив(МассивПараметров);
    Иначе
        Элемент.ПараметрыВыбора = Новый ФиксированныйМассив(Новый Массив);
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура МаршрутПоездкиГородОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
    СтандартнаяОбработка = Ложь;
    ТекущиеДанные = Элементы.МаршрутПоездки.ТекущиеДанные;
    Если ТекущиеДанные = Неопределено Тогда
        Возврат;
    КонецЕсли;
    ТекущиеДанные.Город = ВыбранноеЗначение;
КонецПроцедуры

&НаКлиенте
Процедура СтранаПосещенияПриИзменении(Элемент)
    // Очищаем города и гостиницы в маршруте
    Для каждого Строка Из Объект.МаршрутПоездки Цикл
        Строка.Город = Неопределено;
        Строка.Гостиница = Неопределено;
    КонецЦикла;
    
    // Применяем фильтр для городов по стране
    МаршрутПоездкиГородНачалоВыбора(Элементы.МаршрутПоездкиГород, Неопределено, Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура МаршрутПоездкиГородПриИзменении(Элемент)
    ТекущиеДанные = Элементы.МаршрутПоездки.ТекущиеДанные;
    Если ТекущиеДанные = Неопределено Тогда
        Возврат;
    КонецЕсли;
    
    Если ТекущиеДанные.Город = Неопределено Тогда
        Возврат;
    КонецЕсли;
    
    // Подставляем даты из шапки, если не заполнены
    Если ТекущиеДанные.ДатаНачала = '00010101' Тогда
        ТекущиеДанные.ДатаНачала = Объект.НачалоПоездки;
    КонецЕсли;
    
    Если ТекущиеДанные.ДатаОкончания = '00010101' Тогда
        ТекущиеДанные.ДатаОкончания = Объект.ОкончаниеПоездки;
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура МаршрутПоездкиГостиницаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
    ТекущиеДанные = Элементы.МаршрутПоездки.ТекущиеДанные;
    Если ТекущиеДанные = Неопределено Тогда
        Возврат;
    КонецЕсли;
    
    Если ЗначениеЗаполнено(ТекущиеДанные.Город) Тогда
        НовыйОтбор = Новый ПараметрВыбора("Отбор.Город", ТекущиеДанные.Город);
        МассивПараметров = Новый Массив;
        МассивПараметров.Добавить(НовыйОтбор);
        Элемент.ПараметрыВыбора = Новый ФиксированныйМассив(МассивПараметров);
    Иначе
        Элемент.ПараметрыВыбора = Новый ФиксированныйМассив(Новый Массив);
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Печать(Команда)
	
	// Формируем массив из текущего документа
	МассивДокументов = Новый Массив;
	МассивДокументов.Добавить(Объект.Ссылка);
	
	// Получаем сформированный табличный документ с сервера
	ТабДок = ПечатьНаСервере(МассивДокументов);
	
	// Показываем табличный документ пользователю (СТРОГО НА КЛИЕНТЕ)
	Если ТабДок <> Неопределено Тогда
		ТабДок.Показать("Печатная форма договора");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПечатьНаСервере(МассивДокументов)
	
	// Получаем объект из ссылки, чтобы у него стал доступен метод Печать()
	ДокОбъект = МассивДокументов[0].ПолучитьОбъект();
	
	Возврат ДокОбъект.Печать(МассивДокументов);
	
КонецФункции

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если Объект.ПометкаУдаления Тогда
		
		// Блокируем все поля
		Для каждого ТекЭлемент Из Элементы Цикл
			Если ТипЗнч(ТекЭлемент) = Тип("ПолеФормы") Тогда
				ТекЭлемент.Доступность = Ложь;
			КонецЕсли;
		КонецЦикла;
		
		// Блокируем кнопки
		Если Элементы.Найти("Записать") <> Неопределено Тогда
			Элементы.Записать.Доступность = Ложь;
		КонецЕсли;
		Если Элементы.Найти("Провести") <> Неопределено Тогда
			Элементы.Провести.Доступность = Ложь;
		КонецЕсли;
		
		// ПОКАЗЫВАЕМ КРАСНУЮ НАДПИСЬ
		Элементы.ДекорацияПометкаУдаления.Видимость = Истина;
		
	Иначе
		
		// СКРЫВАЕМ НАДПИСЬ
		Элементы.ДекорацияПометкаУдаления.Видимость = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры